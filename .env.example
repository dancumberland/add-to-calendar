# Weekly Report + Test Auth + Dashboard
# Used by: /api/weekly-report, /api/test-calendars, /api/dashboard, GitHub Actions CI gate
WEEKLY_REPORT_SECRET=your-secure-secret-here
REPORT_URL=https://kit-app-build.vercel.app/api/weekly-report
# Dashboard: https://kit-app-build.vercel.app/api/dashboard?secret=WEEKLY_REPORT_SECRET

# Slack Notifications (DCL Notifications app — #notifications channel)
# Used by: weekly report, schema change monitor (calendar-block), canary-test.js
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GitHub Actions secrets required:
#   WEEKLY_REPORT_SECRET — authenticates /api/test-calendars
#   VERCEL_TOKEN         — used by CI gate to poll for SHA-bound deployment
# Add both at: github.com/[owner]/kit-calendar/settings/secrets/actions

# Debug mode — set to 'true' locally to enable verbose diagnostic logging
# Never set this in production; it gates all 🔍 debug console.log calls
DEBUG=false
